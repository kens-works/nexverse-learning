def assess_node(node_metrics):
  node_data = (node_metrics.get('node_data'))
  config_patch = (node_metrics.get('config_patch'))
  node_data.setdefault('region','us-east-1')
  node_data.setdefault('restart_count',0)
  config_patch['last_audited'] = '2025-01-01'
  if node_data.get('cpu_pct', 0) > 85 or node_data.get('mem_pct', 0) > 90:
    node_metrics['decision'] = 'SCALE_UP'
  elif node_data.get('cpu_pct', 0) < 15 or node_data.get('mem_pct', 0) < 20:
    node_metrics['decision'] = 'SCALE_DOWN'
  else:
    node_metrics['decision'] = 'HEALTHY'

